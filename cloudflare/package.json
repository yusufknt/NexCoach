{
  "name": "nexcoach-cloudflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply nexcoach-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply nexcoach-db --remote",
    "migrate:data": "npx tsx scripts/migrate-data.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
